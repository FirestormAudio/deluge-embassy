# Cargo build outputs
/target/

# Debug / flash artifacts
*.nmdump
*.jdebug.user
/JLinkLog.log

# IDE configs — track the shared debug launch config, ignore everything else
.vscode/*
!.vscode/launch.json
.idea/
*.srctrl*

# macOS
.DS_Store

# Windows
Thumbs.db

# Vendored build inputs (large SVD + rbsp tree) — fetched, not committed
vendor/
**target/
/rtt-flasher.log
**/node_modules/*
.playwright-mcp/

# Vite dependency cache (regeneratable)
.vite/

# The excluded libdeluge crates + linux examples are built ad-hoc against a
# bundle (not workspace members); their Cargo.lock files are build artifacts.
/crates/deluge-sys/Cargo.lock
/crates/deluge-hal-linux/Cargo.lock
/crates/deluge-linux-ui/Cargo.lock
examples-linux/*/Cargo.lock
